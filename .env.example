# Базовые настройки окружения
# URL backend API, к которому обращается фронтенд (без завершающего /)
VITE_API_URL=http://localhost:3000

# Режим приложения для включения окруженческих сценариев (local, dev, stage, prod)
VITE_APP_ENV=local

# Feature flags (1 = включено, 0 = выключено)
# Включает использование реального API вместо mock-адаптера
VITE_FF_USE_REAL_API=0
# Показывает/скрывает административный раздел в интерфейсе
VITE_FF_ENABLE_ADMIN_PANEL=1
# Включает расширенное логирование клиентских событий
VITE_FF_ENABLE_OBSERVABILITY=1
