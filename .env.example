# Default frontend-only local mode
VITE_DATA_SOURCE=mock

# API mode (optional)
# VITE_API_BASE_URL=http://localhost:4000
# VITE_APP_ENV=dev

# See also: .env.dev.example and .env.stage.example for backend-ready matrix.

# Upload client validation
VITE_UPLOAD_MAX_SIZE_MB=250
VITE_UPLOAD_ALLOWED_MIME_TYPES=video/mp4,video/webm,video/quicktime
