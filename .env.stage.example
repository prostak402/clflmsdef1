# Frontend
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=https://api-stage.clipflow.example.com
VITE_APP_ENV=stage

# Backend (stage)
API_PORT=4000
NODE_ENV=production
DB_PATH=/var/lib/clipflow/stage.sqlite3

# CORS
CORS_ALLOWED_ORIGINS=https://stage.clipflow.example.com
CORS_ALLOW_CREDENTIALS=true

# Cookie/token policy
AUTH_ACCESS_TOKEN_TTL_MIN=15
AUTH_REFRESH_TOKEN_TTL_DAYS=14
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_DOMAIN=.clipflow.example.com

# Secrets (must come from secret manager in CI/CD)
AUTH_ACCESS_TOKEN_SECRET=__SET_IN_SECRET_MANAGER__
AUTH_REFRESH_TOKEN_SECRET=__SET_IN_SECRET_MANAGER__
