    "legacy:smoke:stage": "python3 scripts/db/stage_api_smoke.py",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:storage": "vitest run --fileParallelism=false src/test/storage-adapters.test.js src/test/backend-s3-storage-smoke.test.js",
    "smoke:stage": "node scripts/stage-storage-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.917.0",
