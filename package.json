    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --fileParallelism=false src/test/backend-api-smoke.test.js src/test/task-016-route-guards.test.jsx src/test/task-036-session-lifecycle.test.jsx",
    "smoke:local": "node scripts/smoke-local.mjs",
    "legacy:db:migrate": "python3 scripts/db/migrate.py",
