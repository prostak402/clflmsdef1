# Frontend
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_ENV=dev

# Backend (dev)
API_PORT=4000
NODE_ENV=development
DB_PATH=./db/clipflow.sqlite3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# Cookie/token policy
AUTH_ACCESS_TOKEN_TTL_MIN=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=localhost

# Secrets (local only; rotate for shared envs)
AUTH_ACCESS_TOKEN_SECRET=dev-change-me-access
AUTH_REFRESH_TOKEN_SECRET=dev-change-me-refresh

# Upload client validation
VITE_UPLOAD_MAX_SIZE_MB=250
VITE_UPLOAD_ALLOWED_MIME_TYPES=video/mp4,video/webm,video/quicktime

# S3-compatible storage
S3_BUCKET=clipflow-media
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
MAX_CLIP_SIZE_BYTES=262144000
